{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Payments": "Host=localhost;Port=5434;Database=payments;Username=payments_user;Password=payments_pass"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "payments-service",
    "OrderPlacedTopic": "orders.order-placed",
    "PaymentProcessedTopic": "payments.payment-processed",
    "PaymentFailedTopic": "payments.payment-failed",
    "OrderCancelledTopic": "orders.order-cancelled",
    "PaymentRefundedTopic": "payments.payment-refunded",
    "ConsumerRetryBaseDelayMs": 1000,
    "ConsumerRetryMaxDelayMs": 60000,
    "ConsumerMaxAttempts": 5
  },
  "Persistence": {
    "OrderLockTimeoutMs": 5000
  },
  "PaymentPolicy": {
    "MaxAmountThreshold": 10000.00
  },
  "OutboxRelay": {
    "PollIntervalMs": 250,
    "BatchSize": 100,
    "BaseDelayMs": 5000,
    "MaxDelayMs": 600000,
    "MaxRetries": 8
  },
  "Retention": {
    "IntervalMs": 3600000,
    "BatchSize": 1000,
    "OutboxPublishedDays": 30,
    "ConsumedDeadLettersDays": 90,
    "CancellationMarkersDays": 180
  }
}
